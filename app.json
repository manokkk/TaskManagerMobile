{
  "expo": {
    "name": "Galaxy Task RPG",
    "slug": "task-manager-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF1493"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
